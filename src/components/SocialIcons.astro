---
// A link back to the main website, in BTC orange, ahead of Starlight's social icons.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import { Icon } from '@astrojs/starlight/components';
---

<a class="main-site" href="https://verifiedx.io" target="_blank" rel="noopener">
	verifiedx.io
	<Icon name="external" size="0.875rem" />
</a>
<Default />

<style>
	.main-site {
		display: inline-flex;
		align-items: center;
		gap: 0.3125rem;
		margin-inline-end: 0.5rem;
		padding: 0.3125rem 0.75rem;
		border: 1px solid rgb(247 147 26 / 0.55);
		border-radius: 999px;
		color: var(--vfx-btc-orange);
		font-size: var(--sl-text-sm);
		font-weight: 500;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		transition: background 120ms, border-color 120ms;
	}
	.main-site:hover {
		border-color: var(--vfx-btc-orange);
		background: rgb(247 147 26 / 0.1);
		color: var(--vfx-btc-orange);
	}
</style>
