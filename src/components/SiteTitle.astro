---
// The spinning VerifiedX cube, the wordmark and a "Docs" pill, so the header reads as the docs site rather than the main website.
// The cube clip has a black background; mix-blend-mode: screen drops the black against the header.
import { logos } from 'virtual:starlight/user-images';
import config from 'virtual:starlight/user-config';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	<video class="cube" src="/vfx-cube.mp4" autoplay muted loop playsinline disablepictureinpicture aria-hidden="true"></video>
	{logos.dark && <img alt={config.logo?.alt} src={logos.dark.src} width={logos.dark.width} height={logos.dark.height} />}
	<span class="docs-label" aria-hidden="true">Docs</span>
	<span class="sr-only" translate="no">{siteTitle}</span>
</a>

<script>
	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
	const applyMotionPreference = () => {
		document.querySelectorAll<HTMLVideoElement>('.site-title .cube').forEach((video) => {
			if (reducedMotion.matches) video.pause();
			else video.play().catch(() => {});
		});
	};
	applyMotionPreference();
	reducedMotion.addEventListener('change', applyMotionPreference);
</script>

<style>
	.site-title {
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		white-space: nowrap;
	}
	/* The cube fills about 88% of its square as it turns, so the square is a little taller than the wordmark. */
	.cube {
		width: 1.5625rem;
		height: 1.5625rem;
		margin-inline-end: -0.125rem;
		mix-blend-mode: screen;
		pointer-events: none;
	}
	.docs-label {
		padding: 0.1875rem 0.5rem 0.125rem;
		border: 1px solid rgb(115 196 250 / 0.35);
		border-radius: 999px;
		background: rgb(115 196 250 / 0.1);
		color: var(--vfx-ice-blue);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		line-height: 1;
		text-transform: uppercase;
		transition: background 120ms, border-color 120ms;
	}
	.site-title:hover .docs-label {
		border-color: rgb(115 196 250 / 0.6);
		background: rgb(115 196 250 / 0.16);
	}
</style>
