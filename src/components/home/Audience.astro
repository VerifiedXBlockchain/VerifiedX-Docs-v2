---
// A home-page column for one audience (individuals, institutions, developers) with its most useful links.
interface Props {
	title: string;
	description: string;
	color: 'orange' | 'purple' | 'blue' | 'green';
	links: { label: string; href: string }[];
}

const { title, description, color, links } = Astro.props;
---

<section class="audience" data-color={color}>
	<h3>{title}</h3>
	<p>{description}</p>
	<ul>
		{
			links.map((link) => (
				<li>
					<a href={link.href}>
						{link.label}
						<span aria-hidden="true">→</span>
					</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	.audience {
		--c: var(--vfx-ice-blue);
		position: relative;
		padding: 1.25rem 1.25rem 1rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.875rem;
		background:
			radial-gradient(120% 80% at 0% 0%, color-mix(in srgb, var(--c) 12%, transparent), transparent 60%),
			rgb(17 23 30 / 0.7);
		overflow: hidden;
	}
	.audience[data-color='orange'] {
		--c: var(--vfx-btc-orange);
	}
	.audience[data-color='purple'] {
		--c: var(--vfx-vault-purple);
	}
	.audience[data-color='green'] {
		--c: var(--vfx-green);
	}
	.audience::before {
		content: '';
		position: absolute;
		inset: 0 0 auto;
		height: 2px;
		background: linear-gradient(90deg, var(--c), transparent 80%);
	}
	h3 {
		margin: 0;
		color: var(--c);
		font-size: var(--sl-text-lg);
		font-weight: 600;
	}
	p {
		margin: 0.375rem 0 0.875rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.125rem;
	}
	li {
		margin: 0;
	}
	a {
		display: flex;
		justify-content: space-between;
		padding: 0.4rem 0;
		border-top: 1px solid var(--sl-color-hairline);
		color: var(--sl-color-gray-1);
		text-decoration: none;
		font-size: var(--sl-text-sm);
		font-weight: 500;
	}
	a span {
		color: var(--sl-color-gray-4);
		transition: transform 120ms, color 120ms;
	}
	a:hover {
		color: var(--sl-color-white);
	}
	a:hover span {
		color: var(--c);
		transform: translateX(3px);
	}
</style>
