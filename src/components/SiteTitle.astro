---
// The VerifiedX wordmark with a "Docs" label, so the header reads as the docs site rather than the main website.
import { logos } from 'virtual:starlight/user-images';
import config from 'virtual:starlight/user-config';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	{logos.dark && <img alt={config.logo?.alt} src={logos.dark.src} width={logos.dark.width} height={logos.dark.height} />}
	<span class="docs-label" aria-hidden="true">Docs</span>
	<span class="sr-only" translate="no">{siteTitle}</span>
</a>

<style>
	.site-title {
		align-items: center;
		gap: 0.625rem;
		text-decoration: none;
		white-space: nowrap;
	}
	.docs-label {
		padding-inline-start: 0.625rem;
		border-inline-start: 1px solid var(--sl-color-gray-5);
		color: var(--sl-color-gray-2);
		font-size: 1.125rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.5rem;
	}
	.site-title:hover .docs-label {
		color: var(--sl-color-white);
	}
</style>
