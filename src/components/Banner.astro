---
// Starlight's page banner, plus two automatic notices:
//   - on the testnet site, pages that are new or changed compared with mainnet
//   - translated pages whose English source changed after they were translated
import Default from '@astrojs/starlight/components/Banner.astro';
import { isStaleTranslation, pageNetworkStatus, siteUrls } from '../lib/network';

const { t } = Astro.locals;
const { id, entry } = Astro.locals.starlightRoute;
const status = entry.data.template === 'splash' ? null : pageNetworkStatus(id);
const stale = isStaleTranslation(id);
const mainnetHref = new URL(Astro.url.pathname, siteUrls.mainnet).href;
---

<Default />
{
	(status || stale) && (
		<div class="vfx-notices" data-pagefind-ignore>
			<div class="vfx-notices-inner">
				{status && (
					<p class="vfx-notice testnet">
						<span class="dot" aria-hidden="true" />
						<span class="label">{t('vfx.network.testnet')}</span>
						<span>{status === 'new' ? t('vfx.network.calloutNew') : t('vfx.network.calloutChanged')}</span>
						{status === 'changed' && (
							<a href={mainnetHref}>
								{t('vfx.network.viewMainnet')} <span aria-hidden="true">→</span>
							</a>
						)}
					</p>
				)}
				{stale && <p class="vfx-notice stale">{t('vfx.translation.stale')}</p>}
			</div>
		</div>
	)
}

<style>
	/* Same box as Starlight's ContentPanel, so the notices line up with the page text. */
	.vfx-notices {
		padding: 1.25rem var(--sl-content-pad-x) 0;
	}
	.vfx-notices-inner {
		display: grid;
		gap: 0.5rem;
		max-width: var(--sl-content-width);
	}
	@media (min-width: 72rem) {
		.vfx-notices-inner {
			margin-inline: var(--sl-content-margin-inline, auto);
		}
	}
	.vfx-notice {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-3);
	}
	.testnet {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.625rem;
		padding: 0.5rem 0.875rem;
		border: 1px solid rgb(52 211 153 / 0.18);
		border-radius: 0.625rem;
		background: linear-gradient(90deg, rgb(52 211 153 / 0.09), rgb(52 211 153 / 0) 70%);
	}
	.dot {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		background: var(--vfx-green);
		box-shadow: 0 0 0 3px rgb(52 211 153 / 0.18), 0 0 10px rgb(52 211 153 / 0.6);
	}
	.label {
		color: var(--vfx-green);
		font-weight: 600;
	}
	.testnet a {
		margin-inline-start: auto;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		font-weight: 500;
	}
	.testnet a:hover {
		color: var(--vfx-green);
	}
	.stale {
		padding-inline-start: 0.875rem;
		border-inline-start: 2px solid var(--vfx-vault-purple);
	}
</style>
